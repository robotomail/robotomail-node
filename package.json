{
  "name": "@robotomail/sdk",
  "version": "0.1.0",
  "description": "Official Robotomail SDK for TypeScript and JavaScript",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "require": { "types": "./dist-cjs/index.d.ts", "default": "./dist-cjs/index.js" } } },
  "files": ["dist", "dist-cjs", "README.md", "LICENSE", "API.md"],
  "engines": { "node": ">=20.3" },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/robotomail/robotomail-node.git" },
  "homepage": "https://robotomail.com/docs",
  "scripts": {
    "build": "tsc && tsc --module commonjs --moduleResolution node --outDir dist-cjs && node scripts/cjs.cjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": { "typescript": "~5.9.3", "@types/node": "^22.0.0" },
  "publishConfig": { "access": "public" }
}
